# Copy to .env (git-ignored) and load it, e.g. `npx tsx --env-file=.env src/server.ts`,
# or export the variables in your shell before `npm run dev`.

# Required. Bearer token for every /memory and /audit request. The daemon
# refuses to start without it (minimum 16 characters).
# Generate one with: openssl rand -hex 32
AMNESIA_TOKEN=

# Optional. Interface to bind. Default 127.0.0.1 (this machine only).
HOST=

# Optional. Port to listen on. Default 3747.
PORT=

# Optional. Daemon URL used by examples/populate.ts. Default http://127.0.0.1:3747.
AMNESIA_URL=
